# 复制为 deploy/.env 后修改。这个文件会被 docker compose --env-file 读取。

# ===== 必填 =====
# 后台登录密码。留空则后台接口被禁用（登录返回 503）。
ADMIN_PASSWORD=change-me-please

# ===== 镜像（单镜像，GitHub Actions 自动发布）=====
IMAGE_NAME=ghcr.io/564024841/nte-geoguess
IMAGE_TAG=latest

# ===== 端口 =====
# 默认只监听本机，交给宝塔 nginx 反代（域名 + HTTPS）；
# 想直接对外暴露就改成 APP_BIND=0.0.0.0、APP_PORT=8080。
APP_BIND=127.0.0.1
APP_PORT=8787

# ===== 数据（宿主目录挂载）=====
# SQLite 与后台上传截图；务必持久化并在宝塔里做备份。
DATA_HOST_DIR=./data
# 底图瓦片目录（宿主路径）：镜像里不含瓦片，必须挂载；必须是完整瓦片集。
# 用 `npm run tiles:fetch` 拉到仓库同级的 MapSource/tiles，或从别的机器拷过来。
TILES_HOST_DIR=../../MapSource/tiles
# 内容数据目录（宿主路径）：放 map-data.json、navi-coordinate-calibration.json、
# region-positions.json。这些数据不进 git，运行时从这个目录读。
SHARED_DATA_HOST_DIR=../shared-data

# 走 HTTPS 时设为 true（会话 Cookie 会带 Secure，必须配 HTTPS 否则登录不上）
COOKIE_SECURE=false

# 后台登录会话有效期（小时）
SESSION_TTL_HOURS=12

# 后台站与 API 不同源时填写，逗号分隔，例如 https://admin.example.com
CORS_ORIGINS=

# 日志级别：error | warn | info | debug
LOG_LEVEL=info

# ===== 瓦片 =====
# 瓦片缺失/不完整时是否拒绝启动（1=拒绝，默认）。设 0 则只告警、照常启动。
REQUIRE_TILES=1
# 下发给前端的瓦片 URL 模板。nginx 反代时保持默认即可。
TILE_URL_TEMPLATE=/mapsource-tiles/{z}/{x}/{y}.jpg
# 把瓦片交给对象存储/CDN 时填这里（服务端会 302 过去，此时不再需要本地瓦片）
TILE_REDIRECT_BASE=

# ===== 启动自检：缺失自动补全 =====
# 容器启动时若发现瓦片目录为空、或内容数据 JSON 不存在，会自动下载补全（默认开）。
# 设为 0 可关闭；下载源可指向内网镜像。
TILES_AUTO_FETCH=1
DATA_JSON_AUTO_FETCH=1
MAPSOURCE_REPO=Maa-NTE/MapSource
GIT_REPO=564024841/NTE-GeoGuess
GIT_BRANCH=main
# 自动下载的内容数据落在容器内这个目录（默认 /tmp，可挂卷持久化）
# DATA_JSON_CACHE_DIR=/tmp/nte-data-json
