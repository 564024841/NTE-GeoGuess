# 复制为 deploy/.env 后修改。这个文件会被 docker compose --env-file 读取。

# ===== 必填 =====
# 后台登录密码。留空则后台接口被禁用（登录返回 503）。
ADMIN_PASSWORD=change-me-please

# ===== 镜像（单镜像，GitHub Actions 自动发布）=====
IMAGE_NAME=ghcr.io/564024841/nte-geoguess
IMAGE_TAG=latest

# ===== 端口 =====
# 默认只监听本机，交给宝塔 nginx 反代（域名 + HTTPS）；
# 想直接对外暴露就改成 APP_BIND=0.0.0.0、APP_PORT=8080。
APP_BIND=127.0.0.1
APP_PORT=8787

# ===== 数据与瓦片（宿主目录挂载）=====
# SQLite 与后台上传截图；务必持久化并在宝塔里做备份。
DATA_HOST_DIR=./data
# 底图瓦片目录（只读挂载到容器 /srv/tiles）
TILES_HOST_DIR=../../MapSource/tiles

# 走 HTTPS 时设为 true（会话 Cookie 会带 Secure，必须配 HTTPS 否则登录不上）
COOKIE_SECURE=false

# 后台登录会话有效期（小时）
SESSION_TTL_HOURS=12

# 后台站与 API 不同源时填写，逗号分隔，例如 https://admin.example.com
CORS_ORIGINS=

# 日志级别：error | warn | info | debug
LOG_LEVEL=info

# ===== 瓦片 =====
# 瓦片缺失/不完整时是否拒绝启动（1=拒绝，默认）。设 0 则只告警、照常启动。
REQUIRE_TILES=1
# 下发给前端的瓦片 URL 模板。nginx 反代时保持默认即可。
TILE_URL_TEMPLATE=/mapsource-tiles/{z}/{x}/{y}.jpg
# 把瓦片交给对象存储/CDN 时填这里（服务端会 302 过去，此时不再需要本地瓦片）
TILE_REDIRECT_BASE=

# ===== 瓦片：不想在宿主准备目录时（可选）=====
# 设为 1 时，容器首次启动会从 GitHub 拉一次瓦片到 /srv/tiles（约 30MB，只拉一次）。
# 用它就要把 compose 里 /srv/tiles 的只读宿主挂载换成一个可写卷，否则拉不下来。
TILES_AUTO_FETCH=0
MAPSOURCE_REPO=Maa-NTE/MapSource
