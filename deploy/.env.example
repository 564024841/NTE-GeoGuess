# 这个文件有两种用法，内容一样：
#   1) 宝塔「Docker → Compose 项目」：把下面内容整段粘进 env 框（推荐把四个宿主目录
#      写成绝对路径，例如 /www/server/panel/data/compose/nte-geoguess/data）。
#   2) 命令行：复制为 deploy/.env，compose --env-file 读取；此时相对路径按 compose 文件所在目录解析。
#
# 注意：只有 ADMIN_PASSWORD 是必填。缺了 compose 会直接报错，不会起一个没有后台密码的容器。

# ===== 必填 =====
# 后台登录密码。留空则后台接口被禁用（登录返回 503）。
ADMIN_PASSWORD=change-me-please

# ===== 镜像（单镜像，GitHub Actions 自动发布）=====
IMAGE_NAME=ghcr.io/564024841/nte-geoguess
IMAGE_TAG=latest

# ===== 端口 =====
# 默认只监听本机，交给宝塔 nginx 反代（域名 + HTTPS）；
# 想直接对外暴露就改成 APP_BIND=0.0.0.0、APP_PORT=8080。
APP_BIND=127.0.0.1
APP_PORT=8787

# ===== 宿主目录（四个都要持久化，而且容器要能写 → 不要挂成只读）=====
# SQLite + 后台上传截图；务必持久化并在宝塔里做备份。
DATA_HOST_DIR=./data
# 底图瓦片：镜像里不含瓦片，必须挂宿主目录；要用完整瓦片集（z=-6..0 的 {z}/{x}/{y}.jpg）。
# 用 `npm run tiles:fetch` 拉到仓库同级的 MapSource/tiles，或从别的机器拷过来。
# 以后更新瓦片：直接往这个宿主目录里覆盖文件即可，不用重建镜像、也不用重启容器。
TILES_HOST_DIR=./tiles
# 内容数据：map-data.json、navi-coordinate-calibration.json、region-positions.json。
# git 上只有最基本的一份，生产以这个目录里的文件为准（覆盖即生效）。
SHARED_DATA_HOST_DIR=./data-json
# 题面截图：镜像里不带，从这个宿主目录读（内部结构 …/locations/<点位 id>/*.webp）。
# 目录空的时候容器会自己下载一份，落在宿主目录里持久化。
SEED_IMAGES_HOST_DIR=./seed-images

# 走 HTTPS 时设为 true（会话 Cookie 会带 Secure，必须配 HTTPS 否则登录不上）
COOKIE_SECURE=true

# 后台登录会话有效期（小时）
SESSION_TTL_HOURS=12
# 后台登录失败限流：窗口内最多尝试几次
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# 后台站与 API 不同源时填写，逗号分隔，例如 https://admin.example.com
CORS_ORIGINS=

# 日志级别：error | warn | info | debug
LOG_LEVEL=info

# ===== 瓦片 =====
# 瓦片缺失时是否拒绝启动（1=拒绝，默认）。设 0 则只告警、照常启动（底图会全黑）。
REQUIRE_TILES=1
# 下发给前端的瓦片 URL 模板。nginx 反代时保持默认即可。
TILE_URL_TEMPLATE=/mapsource-tiles/{z}/{x}/{y}.jpg
# 把瓦片交给对象存储/CDN 时填这里（服务端会 302 过去，此时不再需要本地瓦片）
TILE_REDIRECT_BASE=

# ===== 启动自检：缺失自动补全 =====
# 容器启动时若发现瓦片目录里没有 jpg、题面截图目录里没有图、或内容数据 JSON 不存在，就下载补全（默认开），
# 只写进上面挂的宿主目录（持久化）。目录不可写、或下载失败 = 直接报错退出。
# 设为 0 则完全不下网：缺文件同样是直接报错退出。
TILES_AUTO_FETCH=1
DATA_JSON_AUTO_FETCH=1
# 题面截图：默认从 MaaNTE-Map 的仓库包（tar.gz）里取 …/images/locations；
# 换成你自己的截图包就填直链（里面是 locations/*.webp），或填成自己的对象存储地址。
SEED_IMAGES_AUTO_FETCH=1
SEED_IMAGES_ARCHIVE_URL=
# 截图缺失时是否拒绝启动（1=拒绝，默认；设 0 则只告警——所有题目会显示破图）
REQUIRE_SEED_IMAGES=1
MAPSOURCE_REPO=Maa-NTE/MapSource
GIT_REPO=564024841/NTE-GeoGuess
GIT_BRANCH=main
