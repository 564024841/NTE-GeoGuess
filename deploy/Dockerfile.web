# nginx 镜像：只放两个前端的构建产物与配置。
# 单独一个镜像的好处是前端与后端可以各自滚动更新，nginx 也不必装 Node。
#
# 构建参数：
#   NPM_REGISTRY  npm 源，网络受限时改成镜像源，例如
#                 --build-arg NPM_REGISTRY=https://registry.npmmirror.com

FROM node:22-bookworm-slim AS builder

WORKDIR /app

ARG NPM_REGISTRY=https://registry.npmjs.org/

# 先复制清单，让「只改源码」的情况命中依赖层缓存
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/game/package.json apps/game/
COPY apps/admin/package.json apps/admin/
COPY server/package.json server/

# 源码必须在 npm ci 之前就位：workspace 包 shared 带 prepare 钩子
# （安装后立即构建自己），而 npm 的 --ignore-scripts 不会跳过 workspace 的 prepare。
COPY packages/shared packages/shared
COPY apps/game apps/game
COPY apps/admin apps/admin

# 前端构建不需要任何原生模块，所以 --ignore-scripts 很安全
RUN npm ci --no-audit --no-fund --ignore-scripts --registry="$NPM_REGISTRY" \
  && npm run build:shared \
  && npm run build:game \
  && npm run build:admin

FROM nginx:1.27-alpine

COPY --from=builder /app/apps/game/dist /srv/game
COPY --from=builder /app/apps/admin/dist /srv/admin
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY deploy/nginx-snippets/ /etc/nginx/snippets/

EXPOSE 8080 8081
